NODE_ENV=production
PORT=3000

# Security
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=7d

# MariaDB
DB_HOST=capivara_db
DB_PORT=3306
DB_NAME=capivara
DB_USER=capivara_user
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-root-password

# InitDB automatico ao subir app
INITDB_CREATE_DATABASE=true
INITDB_ALTER=true

# CORS (separar por virgula)
CORS_ORIGINS=https://capivara.aporttec.com